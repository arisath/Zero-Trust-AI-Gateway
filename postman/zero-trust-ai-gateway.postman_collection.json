{
  "info": {
    "name": "Zero-Trust AI Gateway",
    "_postman_id": "zero-trust-ai-gateway",
    "description": "Collection for the Zero-Trust AI Gateway — covers auth-service token issuance and all ai-gateway endpoints.\n\n**Workflow (prod profile)**:\n1. Run \"Get Access Token (Client Credentials)\" → token is saved to `{{access_token}}`\n2. Use any secured request — the Bearer token is set automatically via the collection variable\n\n**Local profile** (auth disabled): skip step 1 and send requests directly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_base_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "auth_base_url",
      "value": "http://localhost:9000",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "ai-gateway-client",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "secret",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth Service",
      "description": "OAuth2 Authorization Server — issues signed JWT tokens.",
      "item": [
        {
          "name": "Get Access Token (Client Credentials)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('access_token', json.access_token);",
                  "    pm.test('access_token is present', () => pm.expect(json.access_token).to.be.a('string').and.not.empty);",
                  "    pm.test('token_type is Bearer', () => pm.expect(json.token_type).to.eql('Bearer'));",
                  "    pm.test('expires_in is ~3600', () => pm.expect(json.expires_in).to.be.closeTo(3600, 10));",
                  "    console.log('Token saved to collection variable access_token');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{client_id}}", "type": "string" },
                { "key": "password", "value": "{{client_secret}}", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "scope", "value": "gateway.read", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{auth_base_url}}/oauth2/token",
              "host": ["{{auth_base_url}}"],
              "path": ["oauth2", "token"]
            },
            "description": "Issues a JWT access token using client credentials. The token is automatically saved to the `access_token` collection variable."
          },
          "response": [
            {
              "name": "200 OK — token issued",
              "originalRequest": {
                "method": "POST",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    { "key": "grant_type", "value": "client_credentials" },
                    { "key": "scope", "value": "gateway.read" }
                  ]
                },
                "url": { "raw": "{{auth_base_url}}/oauth2/token" }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"access_token\": \"eyJ...\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3600,\n  \"scope\": \"gateway.read\"\n}"
            }
          ]
        },
        {
          "name": "OIDC Discovery",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_base_url}}/.well-known/openid-configuration",
              "host": ["{{auth_base_url}}"],
              "path": [".well-known", "openid-configuration"]
            },
            "description": "Returns the OIDC discovery document — lists supported endpoints, algorithms, and scopes."
          },
          "response": []
        },
        {
          "name": "JWKS (Public Keys)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_base_url}}/oauth2/jwks",
              "host": ["{{auth_base_url}}"],
              "path": ["oauth2", "jwks"]
            },
            "description": "Returns the RSA public key(s) used to sign JWTs. The ai-gateway fetches this to validate incoming tokens."
          },
          "response": []
        },
        {
          "name": "Auth Service Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_base_url}}/actuator/health",
              "host": ["{{auth_base_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Health check — returns `{\"status\":\"UP\"}` when the auth service is running."
          },
          "response": []
        },
        {
          "name": "Bad Credentials (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 for bad credentials', () => pm.response.to.have.status(401));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{client_id}}", "type": "string" },
                { "key": "password", "value": "wrong-secret", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{auth_base_url}}/oauth2/token",
              "host": ["{{auth_base_url}}"],
              "path": ["oauth2", "token"]
            },
            "description": "Verifies that an invalid client secret is rejected with 401."
          },
          "response": []
        }
      ]
    },
    {
      "name": "AI Gateway — Chat",
      "description": "POST /api/chat — classify prompt and route to the appropriate specialist LLM.",
      "item": [
        {
          "name": "Chat — Programming Query",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('response field present', () => pm.expect(json.response).to.be.a('string').and.not.empty);",
                  "pm.test('category field present', () => pm.expect(json.category).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Write a binary search algorithm in Java.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{gateway_base_url}}/api/chat",
              "host": ["{{gateway_base_url}}"],
              "path": ["api", "chat"]
            },
            "description": "Should be classified as PROGRAMMING and routed to codellama:7b."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"response\": \"public int binarySearch(int[] arr, int target) { ... }\",\n  \"category\": \"PROGRAMMING\"\n}"
            }
          ]
        },
